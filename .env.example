# Environment Variables
# Copy to .env.local and fill in values

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL="file:./dev.db"

# ─── Coinflow Payment Provider ─────────────────────────────
# Server-side configuration (never exposed to browser)
COINFLOW_API_KEY=
COINFLOW_WEBHOOK_SIGNING_SECRET=
COINFLOW_ENV=sandbox

# Browser-safe configuration (exposed to client via NEXT_PUBLIC_)
NEXT_PUBLIC_COINFLOW_MERCHANT_ID=
NEXT_PUBLIC_COINFLOW_ENV=sandbox

# Expected settlement configuration
COINFLOW_EXPECTED_SETTLEMENT_ASSET=USDC
COINFLOW_EXPECTED_SETTLEMENT_NETWORK=solana
COINFLOW_EXPECTED_SETTLEMENT_ADDRESS=

# Scheduled job authentication
CRON_SECRET=change-me-in-production

# Administrator access
ADMIN_EMAILS=
OWNER_EMAILS=

# ─── Shopify Storefront API (future commerce provider) ─────
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# ─── Newsletter provider (future) ──────────────────────────
# NEWSLETTER_PROVIDER=mailchimp
# NEWSLETTER_API_KEY=your-key
# NEWSLETTER_LIST_ID=your-list-id

# ─── NEVER add these to any environment: ────────────────────
# WALLET_PRIVATE_KEY=
# MERCHANT_PRIVATE_KEY=
# SOLANA_PRIVATE_KEY=
# WALLET_SEED_PHRASE=
