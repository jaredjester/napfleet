# ─── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────
# SQLite for local dev: "file:./prisma/dev.db"
# PostgreSQL for production (Neon/Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL="file:./prisma/dev.db"

# ─── Authentication ─────────────────────────────────────────
# Session secret for iron-session (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-char-string
# Admin password bcrypt hash (generate with: npx tsx -e "const bcrypt=require('bcryptjs');bcrypt.hash('yourpassword',10).then(h=>console.log(h))")
ADMIN_PASSWORD_HASH=

# ─── Coinflow Payment Provider ──────────────────────────────
# Server-side configuration (NEVER exposed to browser)
COINFLOW_API_KEY=
COINFLOW_WEBHOOK_SIGNING_SECRET=
COINFLOW_ENV=sandbox

# Browser-safe configuration (exposed to client via NEXT_PUBLIC_)
NEXT_PUBLIC_COINFLOW_MERCHANT_ID=
NEXT_PUBLIC_COINFLOW_ENV=sandbox

# Expected settlement configuration
COINFLOW_EXPECTED_SETTLEMENT_ASSET=USDC
COINFLOW_EXPECTED_SETTLEMENT_NETWORK=solana
COINFLOW_EXPECTED_SETTLEMENT_ADDRESS=

# ─── Scheduled Jobs ─────────────────────────────────────────
CRON_SECRET=change-me-in-production

# ─── Email (Resend) ─────────────────────────────────────────
# https://resend.com — get API key from dashboard
RESEND_API_KEY=
# FROM address for transactional emails
EMAIL_FROM="NapFleet <orders@napfleet.com>"

# ─── Administrator ─────────────────────────────────────────
ADMIN_EMAILS=
OWNER_EMAILS=

# ─── Shopify (future commerce provider) ────────────────────
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# ─── Newsletter (future) ───────────────────────────────────
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=

# ─── Tax (future: TaxJar, Avalara, etc.) ───────────────────
# TAX_PROVIDER=mock
# TAXJAR_API_KEY=

# ─── Shipping (future: Shippo, EasyPost, etc.) ─────────────
# SHIPPING_PROVIDER=mock
# SHIPPO_API_KEY=

# ─── NEVER add these to any environment ────────────────────
# WALLET_PRIVATE_KEY=
# MERCHANT_PRIVATE_KEY=
# SOLANA_PRIVATE_KEY=
# WALLET_SEED_PHRASE=
